# Copy to .env.local.

# Data source. "mock" (default): an in-browser mock backend built from the demo seed, with a simulated platform-admin
# wallet. "live": the real backend through the proxy below, and real Stellar wallets. Only wallets listed in the
# backend's ADMIN_WALLETS get in (`roles.platformAdmin`).
# NEXT_PUBLIC_DATA_MODE=mock

# The AidTrace backend the same-origin proxy forwards `/api/v1/*` to (next.config.ts), including its `/api` prefix.
# API_PROXY_TARGET=https://api.aidtrace.africa/api

# WalletConnect (Reown) project id for the Stellar Wallets Kit (src/features/wallet/kit.ts has a default).
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
