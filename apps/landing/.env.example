# Copy to .env.local. Nothing here is required: every URL has a default per environment (src/lib/site.ts).

# "mock" (default) reads the shared demo seed (packages/mock); "live" fetches the backend below.
# NEXT_PUBLIC_DATA_MODE=mock

# This site's canonical URL (metadata, robots).
# NEXT_PUBLIC_SITE_URL=http://localhost:3002

# Where links into the app go (apps/web).
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# The backend, for server-side reads of featured campaigns and statistics (defaults to http://localhost:4000/v1).
# AIDTRACE_API_URL=https://api.example.com/v1
