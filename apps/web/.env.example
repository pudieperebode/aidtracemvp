# Copy to .env.local.

# Data source. "mock" (default): an in-browser mock backend with simulated wallet signatures and Stellar
# confirmations, so every flow can be walked through before the backend exists (Demo panel, bottom left).
# "live": the real backend through the proxy below, and real Stellar wallets.
# NEXT_PUBLIC_DATA_MODE=mock

# The AidTrace backend the same-origin proxy forwards `/api/v1/*` to (next.config.ts). Its routes sit under `/v1`.
# Defaults to http://localhost:4000 for local backend development.
# API_PROXY_TARGET=https://api.example.com

# Or skip the proxy and call the backend directly (it must then allow this origin in CORS).
# NEXT_PUBLIC_API_URL=https://api.example.com/v1

# The deployed AidTrace Soroban contract on Testnet (contracts/aidtrace, see contracts/README.md).
# NEXT_PUBLIC_AIDTRACE_CONTRACT_ID=C...

# Soroban RPC (defaults to https://soroban-testnet.stellar.org).
# NEXT_PUBLIC_SOROBAN_RPC_URL=

# WalletConnect (Reown) project id for the Stellar Wallets Kit (src/features/wallet/kit.ts has a default).
# Create AidTrace's own at https://cloud.reown.com before launch.
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Serve the app at the root instead of /app on Vercel (only once it has its own domain).
# APP_BASE_PATH=

# Canonical URLs (optional) - src/lib/site.ts.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_LANDING_URL=http://localhost:3002
